repeat task.wait() until game:IsLoaded()

local G = getgenv()

local lib = loadstring(game:HttpGet("https://projectlds.online/loader/Library"))()

local window = lib:start("Button Eternal 2", "1.0", true)
local tabMain = window:addTab("Main")

local Rs = cloneref(game:GetService("ReplicatedStorage"))
local Players = cloneref(game:GetService("Players"))

local BlocksData = require(Rs.Shared.Info.MiningInfo.Blocks)
local MiningServiceClient = require(Rs.Shared.Services.MiningService.MiningServiceClient)
local MiningInfo = require(Rs.Packages.Info).MiningInfo

G.Settings = G.Settings or {}

--------------------------------------------------
-- RANK -> MAX DEPTH
--------------------------------------------------

local RankDepths = {
    Starter = 9,
    Advanced = 9,

    Expert = 29,
    Master = 29,

    Elite = 69,
    Champion = 69,
    Legend = 69,

    Mythic = 149,
    Titan = 149,

    Immortal = 299,
    Celestial = 299,

    Cosmic = 799,
    Galactic = 799,
    Eternal = 799,
    Omniversal = 799
}

--------------------------------------------------
-- STONE = LOWEST PRIORITY
--------------------------------------------------

local StoneOres = {
    StoneOre = true,
    StoneOre1 = true,
    StoneOre2 = true,
    StoneOre3 = true,
    StoneOre4 = true,
    StoneOre5 = true,
    StoneOre6 = true,
    StoneOre7 = true
}

--------------------------------------------------
-- BLOCK LIST
--------------------------------------------------

local Blocks = {}

for i, g in pairs(BlocksData) do
    table.insert(Blocks, i)
end

--------------------------------------------------
-- CURRENT RANK
--------------------------------------------------

local function getCurrentRank()

    local player = Players.LocalPlayer
    local playerGui = player:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local main = playerGui:FindFirstChild("Main")

    if not main then
        return nil
    end

    local frames = main:FindFirstChild("Frames")

    if not frames then
        return nil
    end

    local ranksMining = frames:FindFirstChild("Ranks_Mining")

    if not ranksMining then
        return nil
    end

    local holder = ranksMining:FindFirstChild("Holder")

    if not holder then
        return nil
    end

    local currentRank = holder:FindFirstChild("CurrentRank")

    if not currentRank then
        return nil
    end

    local currentHolder = currentRank:FindFirstChild("Holder")

    if not currentHolder then
        return nil
    end

    local nameObject = currentHolder:FindFirstChild("Name")

    if not nameObject then
        return nil
    end

    if not nameObject:IsA("TextLabel")
        and not nameObject:IsA("TextButton")
        and not nameObject:IsA("TextBox") then
        return nil
    end

    return nameObject.Text
end

--------------------------------------------------
-- RANK DEPTH
--------------------------------------------------

local function getRankDepth()

    local rank = getCurrentRank()

    if not rank then
        return nil, nil
    end

    rank = rank:gsub("^%s+", ""):gsub("%s+$", "")

    return rank, RankDepths[rank]
end

--------------------------------------------------
-- BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData = MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if blockId == "None" then
        return nil
    end

    local info = MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }
end

--------------------------------------------------
-- COORDINATES
--------------------------------------------------

local function getBlockCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        block.Name:match("^(-?%d+)_(-?%d+)_(-?%d+)$")

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)
end

--------------------------------------------------
-- FIND BLOCK
--------------------------------------------------

local function getBlockAt(x, y, z)

    local folder = workspace.Maps.Mining.Blocks

    if not folder then
        return nil
    end

    local name =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    return folder:FindFirstChild(name)
end

--------------------------------------------------
-- DAMAGE
--------------------------------------------------

local function damageSpecificBlock(blockName)

    if not MiningServiceClient.mineFolder then
        return false
    end

    local block =
        MiningServiceClient.mineFolder:FindFirstChild(blockName)

    if not block then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true
end

--------------------------------------------------
-- MINE BLOCK
--------------------------------------------------

local function mineBlock(block, selected)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(selected, info.Id) then
        return false
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        damageSpecificBlock(block.Name)

        task.wait()
    end

    return true
end

--------------------------------------------------
-- CHECK IF PRIORITY ORE
--------------------------------------------------

local function isPriority(block, selected)

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(selected, info.Id) then
        return false
    end

    return not StoneOres[info.Id]
end

--------------------------------------------------
-- FIND PRIORITY ORE ANYWHERE
--
-- THIS SEARCHES EVERY LAYER
--------------------------------------------------

local function findPriorityOre(selected, lastX, lastY, lastZ)

    local folder = workspace.Maps.Mining.Blocks

    if not folder then
        return nil
    end

    local nearby = {}
    local all = {}

    for _, block in ipairs(folder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z = getBlockCoordinates(block)

            if x and y and z then

                local info = getBlockInfo(block)

                if info
                    and table.find(selected, info.Id)
                    and not StoneOres[info.Id] then

                    table.insert(all, block)

                    --------------------------------------------------
                    -- 3D NEARBY
                    --
                    -- LEFT / RIGHT
                    -- FORWARD / BACK
                    -- UP / DOWN
                    --------------------------------------------------

                    if math.abs(x - lastX) <= 5
                        and math.abs(y - lastY) <= 5
                        and math.abs(z - lastZ) <= 5 then

                        table.insert(nearby, block)
                    end
                end
            end
        end
    end

    if #nearby > 0 then
        return nearby[math.random(1, #nearby)]
    end

    if #all > 0 then
        return all[math.random(1, #all)]
    end

    return nil
end

--------------------------------------------------
-- FIND STONE ANYWHERE
--
-- ONLY USED WHEN NO PRIORITY ORE EXISTS
--------------------------------------------------

local function findStoneOre(selected, lastX, lastY, lastZ)

    local folder = workspace.Maps.Mining.Blocks

    if not folder then
        return nil
    end

    local nearby = {}
    local all = {}

    for _, block in ipairs(folder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z = getBlockCoordinates(block)

            if x and y and z then

                local info = getBlockInfo(block)

                if info
                    and table.find(selected, info.Id)
                    and StoneOres[info.Id] then

                    table.insert(all, block)

                    if math.abs(x - lastX) <= 5
                        and math.abs(y - lastY) <= 5
                        and math.abs(z - lastZ) <= 5 then

                        table.insert(nearby, block)
                    end
                end
            end
        end
    end

    if #nearby > 0 then
        return nearby[math.random(1, #nearby)]
    end

    if #all > 0 then
        return all[math.random(1, #all)]
    end

    return nil
end

--------------------------------------------------
-- FIND NEXT RANDOM TARGET
--
-- PRIORITY ORE FIRST
-- STONE SECOND
--
-- SEARCHES ALL LAYERS
--------------------------------------------------

local function getNextRandomTarget(
    selected,
    lastX,
    lastY,
    lastZ
)

    --------------------------------------------------
    -- FIRST: PRIORITY ORE
    --------------------------------------------------

    local priority =
        findPriorityOre(
            selected,
            lastX,
            lastY,
            lastZ
        )

    if priority then
        return priority
    end

    --------------------------------------------------
    -- SECOND: STONE
    --------------------------------------------------

    return findStoneOre(
        selected,
        lastX,
        lastY,
        lastZ
    )
end

--------------------------------------------------
-- AUTO MINE
--------------------------------------------------

tabMain:addToggleMultiCombo(
    "Auto Mine",
    "...",
    Blocks,
    "All",

    function(value, selected)

        G.Settings["Auto Mine"] = value

        if not value then
            return
        end

        task.spawn(function()

            --------------------------------------------------
            -- START DOWNWARD
            --------------------------------------------------

            local currentDepth = 0
            local currentRank = nil

            --------------------------------------------------
            -- RANDOM MODE
            --------------------------------------------------

            local randomMining = false

            local randomX = 9
            local randomY = 0
            local randomZ = 9

            while G.Settings["Auto Mine"] do

                local rank, maxDepth = getRankDepth()

                if rank and maxDepth then

                    --------------------------------------------------
                    -- RANK CHANGED
                    --------------------------------------------------

                    if rank ~= currentRank then

                        currentRank = rank

                        currentDepth = 0

                        randomMining = false

                        randomX = 9
                        randomY = 0
                        randomZ = 9
                    end

                    --------------------------------------------------
                    -- PHASE 1:
                    -- MINE DOWN
                    --------------------------------------------------

                    if not randomMining then

                        if math.abs(currentDepth) <= maxDepth then

                            local block =
                                getBlockAt(
                                    9,
                                    currentDepth,
                                    9
                                )

                            if block then

                                local info =
                                    getBlockInfo(block)

                                if info
                                    and table.find(
                                        selected,
                                        info.Id
                                    ) then

                                    mineBlock(
                                        block,
                                        selected
                                    )
                                end
                            end

                            --------------------------------------------------
                            -- NEXT Y
                            --------------------------------------------------

                            currentDepth -= 1

                        else

                            --------------------------------------------------
                            -- MAX DEPTH REACHED
                            --
                            -- START 3D RANDOM MINING
                            --------------------------------------------------

                            randomMining = true

                            randomX = 9
                            randomY = -maxDepth
                            randomZ = 9
                        end

                    --------------------------------------------------
                    -- PHASE 2:
                    -- RANDOM 3D MINING
                    --------------------------------------------------

                    else

                        --------------------------------------------------
                        -- FIND PRIORITY ORE ANYWHERE
                        --
                        -- IF NONE, FIND STONE
                        --------------------------------------------------

                        local target =
                            getNextRandomTarget(
                                selected,
                                randomX,
                                randomY,
                                randomZ
                            )

                        if target then

                            local x, y, z =
                                getBlockCoordinates(target)

                            if x and y and z then

                                --------------------------------------------------
                                -- MOVE TARGET POSITION
                                --
                                -- THIS ALLOWS:
                                --
                                -- LEFT
                                -- RIGHT
                                -- FORWARD
                                -- BACK
                                -- UP
                                -- DOWN
                                --------------------------------------------------

                                randomX = x
                                randomY = y
                                randomZ = z

                                --------------------------------------------------
                                -- MINE TARGET
                                --------------------------------------------------

                                mineBlock(
                                    target,
                                    selected
                                )
                            end

                        else

                            --------------------------------------------------
                            -- NOTHING LOADED RIGHT NOW
                            -- KEEP SEARCHING
                            --------------------------------------------------

                            task.wait()
                        end
                    end

                else

                    task.wait()
                end

                task.wait()
            end
        end)
    end
)
