repeat task.wait() until game:IsLoaded()

local G = getgenv()

local lib = loadstring(game:HttpGet("https://projectlds.online/loader/Library"))()

local window = lib:start("Button Eternal 2", "1.0", true)

local tabMain = window:addTab("Main")

local Rs = cloneref(game:GetService("ReplicatedStorage"))
local Players = cloneref(game:GetService("Players"))

local BlocksData = require(Rs.Shared.Info.MiningInfo.Blocks)
local MiningServiceClient = require(Rs.Shared.Services.MiningService.MiningServiceClient)
local MiningInfo = require(Rs.Packages.Info).MiningInfo

G.Settings = G.Settings or {}

--------------------------------------------------
-- RANK -> MAX DEPTH
--------------------------------------------------

local RankDepths = {
    Starter = 9,
    Advanced = 9,

    Expert = 29,
    Master = 29,

    Elite = 69,
    Champion = 69,
    Legend = 69,

    Mythic = 149,
    Titan = 149,

    Immortal = 299,
    Celestial = 299,

    Cosmic = 799,
    Galactic = 799,
    Eternal = 799,
    Omniversal = 799
}

--------------------------------------------------
-- BLOCK LIST
--------------------------------------------------

local Blocks = {}

for i, g in pairs(BlocksData) do
    table.insert(Blocks, i)
end

--------------------------------------------------
-- GET CURRENT RANK
--------------------------------------------------

local function getCurrentRank()

    local player = Players.LocalPlayer
    local playerGui = player:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local main = playerGui:FindFirstChild("Main")

    if not main then
        return nil
    end

    local frames = main:FindFirstChild("Frames")

    if not frames then
        return nil
    end

    local ranksMining = frames:FindFirstChild("Ranks_Mining")

    if not ranksMining then
        return nil
    end

    local holder = ranksMining:FindFirstChild("Holder")

    if not holder then
        return nil
    end

    local currentRank = holder:FindFirstChild("CurrentRank")

    if not currentRank then
        return nil
    end

    local currentHolder = currentRank:FindFirstChild("Holder")

    if not currentHolder then
        return nil
    end

    local nameObject = currentHolder:FindFirstChild("Name")

    if not nameObject then
        return nil
    end

    if not nameObject:IsA("TextLabel")
        and not nameObject:IsA("TextButton")
        and not nameObject:IsA("TextBox") then
        return nil
    end

    return nameObject.Text
end

--------------------------------------------------
-- GET DEPTH FROM RANK
--------------------------------------------------

local function getRankDepth()

    local rank = getCurrentRank()

    if not rank then
        return nil, nil
    end

    rank = rank:gsub("^%s+", ""):gsub("%s+$", "")

    local depth = RankDepths[rank]

    return rank, depth
end

--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData = MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if blockId == "None" then
        return {
            Id = "None",
            Name = "Bloco destruído"
        }
    end

    local info = MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }
end

--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageSpecificBlock(blockName)

    if not MiningServiceClient.mineFolder then
        return false
    end

    local block = MiningServiceClient.mineFolder:FindFirstChild(blockName)

    if not block then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true
end

--------------------------------------------------
-- FIND BLOCK
--------------------------------------------------

local function getBlockAtDepth(x, y, z)

    local blocksFolder = workspace.Maps.Mining.Blocks

    local blockName =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    return blocksFolder:FindFirstChild(blockName)
end

--------------------------------------------------
-- MINE ONE BLOCK
--------------------------------------------------

local function mineBlock(x, y, z, selected)

    local blockName =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    local block = getBlockAtDepth(x, y, z)

    if not block then
        return false
    end

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(selected, info.Id) then
        return false
    end

    repeat

        if not G.Settings["Auto Mine"] then
            return false
        end

        if block.Parent == nil then
            break
        end

        damageSpecificBlock(blockName)

        task.wait()

    until block.Parent == nil

    return true
end

--------------------------------------------------
-- GET COORDINATES FROM BLOCK NAME
--------------------------------------------------

local function getBlockCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        block.Name:match("^(-?%d+)_(-?%d+)_(-?%d+)$")

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)
end

--------------------------------------------------
-- GET RANDOM BLOCK AT MAX DEPTH
--------------------------------------------------

local function getRandomBlockAtDepth(depth, selected, lastX, lastZ)

    local blocksFolder = workspace.Maps.Mining.Blocks

    if not blocksFolder then
        return nil
    end

    local nearby = {}
    local allBlocks = {}

    --------------------------------------------------
    -- FIND BLOCKS ON EXACT DEPTH
    --------------------------------------------------

    for _, block in ipairs(blocksFolder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z = getBlockCoordinates(block)

            if x and y and z and y == depth then

                local info = getBlockInfo(block)

                if info and table.find(selected, info.Id) then

                    table.insert(allBlocks, block)

                    --------------------------------------------------
                    -- Nearby = within 5 blocks
                    --------------------------------------------------

                    if math.abs(x - lastX) <= 5
                        and math.abs(z - lastZ) <= 5 then

                        table.insert(nearby, block)

                    end

                end

            end

        end

    end

    --------------------------------------------------
    -- PREFER NEARBY BLOCKS
    --------------------------------------------------

    if #nearby > 0 then
        return nearby[math.random(1, #nearby)]
    end

    --------------------------------------------------
    -- IF NO NEARBY BLOCK, RANDOM ANYWHERE
    --------------------------------------------------

    if #allBlocks > 0 then
        return allBlocks[math.random(1, #allBlocks)]
    end

    return nil
end

--------------------------------------------------
-- AUTO MINE
--------------------------------------------------

tabMain:addToggleMultiCombo(
    "Auto Mine",
    "...",
    Blocks,
    "All",
    function(value, selected)

        G.Settings["Auto Mine"] = value

        if not value then
            return
        end

        task.spawn(function()

            --------------------------------------------------
            -- SAME STARTING VALUES AS YOUR ORIGINAL
            --------------------------------------------------

            local currentDepth = 0
            local currentRank = nil

            --------------------------------------------------
            -- RANDOM MINING VARIABLES
            --------------------------------------------------

            local randomMining = false
            local randomX = 9
            local randomZ = 9
            local randomDepth = nil

            while G.Settings["Auto Mine"] do

                --------------------------------------------------
                -- CHECK RANK
                --------------------------------------------------

                local rank, maxDepth = getRankDepth()

                if rank and maxDepth then

                    --------------------------------------------------
                    -- RANK CHANGED
                    --------------------------------------------------

                    if rank ~= currentRank then

                        currentRank = rank

                        --------------------------------------------------
                        -- RESET EVERYTHING
                        --------------------------------------------------

                        currentDepth = 0

                        randomMining = false

                        randomDepth = nil

                        randomX = 9
                        randomZ = 9

                        print(
                            "Current Rank:",
                            rank,
                            "| Max Depth:",
                            maxDepth
                        )

                    end

                    --------------------------------------------------
                    -- NORMAL DOWNWARD MINING
                    --------------------------------------------------

                    if not randomMining then

                        if math.abs(currentDepth) <= maxDepth then

                            --------------------------------------------------
                            -- THIS IS THE SAME PATH AS YOUR ORIGINAL
                            --
                            -- 9_0_9
                            -- 9_-1_9
                            -- 9_-2_9
                            -- ...
                            --------------------------------------------------

                            mineBlock(
                                9,
                                currentDepth,
                                9,
                                selected
                            )

                            currentDepth -= 1

                        else

                            --------------------------------------------------
                            -- MAX DEPTH REACHED
                            --------------------------------------------------

                            randomMining = true

                            randomDepth = -maxDepth

                            randomX = 9
                            randomZ = 9

                            print(
                                "MAX DEPTH REACHED:",
                                randomDepth
                            )

                            print(
                                "Starting random mining at:",
                                randomDepth
                            )

                        end

                    else

                        --------------------------------------------------
                        -- RANDOM MINING
                        --
                        -- STAYS AT THE SAME Y
                        --------------------------------------------------

                        local randomBlock =
                            getRandomBlockAtDepth(
                                randomDepth,
                                selected,
                                randomX,
                                randomZ
                            )

                        if randomBlock then

                            local x, y, z =
                                getBlockCoordinates(randomBlock)

                            if x and y and z then

                                randomX = x
                                randomZ = z

                                --------------------------------------------------
                                -- MINE RANDOM BLOCK
                                --------------------------------------------------

                                mineBlock(
                                    x,
                                    y,
                                    z,
                                    selected
                                )

                            end

                        else

                            task.wait()

                        end

                    end

                else

                    task.wait()

                end

                task.wait()

            end

        end)

    end
)
