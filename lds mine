repeat task.wait() until game:IsLoaded()

local G = getgenv()

local lib = loadstring(game:HttpGet("https://projectlds.online/loader/Library"))()

local window = lib:start("Button Eternal 2", "1.0", true)

local tabMain = window:addTab("Main")

local Rs = cloneref(game:GetService("ReplicatedStorage"))
local Players = cloneref(game:GetService("Players"))

local BlocksData = require(Rs.Shared.Info.MiningInfo.Blocks)
local MiningServiceClient = require(Rs.Shared.Services.MiningService.MiningServiceClient)
local MiningInfo = require(Rs.Packages.Info).MiningInfo

G.Settings = G.Settings or {}

--------------------------------------------------
-- RANK -> MAX DEPTH
--------------------------------------------------

local RankDepths = {
    Starter = 9,
    Advanced = 9,

    Expert = 29,
    Master = 29,

    Elite = 69,
    Champion = 69,
    Legend = 69,

    Mythic = 149,
    Titan = 149,

    Immortal = 299,
    Celestial = 299,

    Cosmic = 799,
    Galactic = 799,
    Eternal = 799,
    Omniversal = 799
}

--------------------------------------------------
-- STONE ORES = LOWEST PRIORITY
--------------------------------------------------

local StoneOres = {
    StoneOre = true,
    StoneOre1 = true,
    StoneOre2 = true,
    StoneOre3 = true,
    StoneOre4 = true,
    StoneOre5 = true,
    StoneOre6 = true,
    StoneOre7 = true
}

--------------------------------------------------
-- BLOCK LIST
--------------------------------------------------

local Blocks = {}

for i, g in pairs(BlocksData) do
    table.insert(Blocks, i)
end

--------------------------------------------------
-- GET CURRENT RANK
--------------------------------------------------

local function getCurrentRank()

    local player = Players.LocalPlayer
    local playerGui = player:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local main = playerGui:FindFirstChild("Main")

    if not main then
        return nil
    end

    local frames = main:FindFirstChild("Frames")

    if not frames then
        return nil
    end

    local ranksMining = frames:FindFirstChild("Ranks_Mining")

    if not ranksMining then
        return nil
    end

    local holder = ranksMining:FindFirstChild("Holder")

    if not holder then
        return nil
    end

    local currentRank = holder:FindFirstChild("CurrentRank")

    if not currentRank then
        return nil
    end

    local currentHolder = currentRank:FindFirstChild("Holder")

    if not currentHolder then
        return nil
    end

    local nameObject = currentHolder:FindFirstChild("Name")

    if not nameObject then
        return nil
    end

    if not nameObject:IsA("TextLabel")
        and not nameObject:IsA("TextButton")
        and not nameObject:IsA("TextBox") then

        return nil
    end

    return nameObject.Text
end

--------------------------------------------------
-- GET RANK DEPTH
--------------------------------------------------

local function getRankDepth()

    local rank = getCurrentRank()

    if not rank then
        return nil, nil
    end

    rank = rank:gsub("^%s+", ""):gsub("%s+$", "")

    return rank, RankDepths[rank]
end

--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData = MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if blockId == "None" then
        return nil
    end

    local info = MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }
end

--------------------------------------------------
-- GET COORDINATES
--------------------------------------------------

local function getBlockCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        block.Name:match("^(-?%d+)_(-?%d+)_(-?%d+)$")

    if not x then
        return nil
    end

    return tonumber(x), tonumber(y), tonumber(z)
end

--------------------------------------------------
-- FIND BLOCK AT COORDINATE
--------------------------------------------------

local function getBlockAtDepth(x, y, z)

    local folder = workspace.Maps.Mining.Blocks

    if not folder then
        return nil
    end

    local name =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    return folder:FindFirstChild(name)
end

--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageSpecificBlock(blockName)

    if not MiningServiceClient.mineFolder then
        return false
    end

    local block =
        MiningServiceClient.mineFolder:FindFirstChild(blockName)

    if not block then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true
end

--------------------------------------------------
-- CHECK IF PRIORITY ORE
--------------------------------------------------

local function isPriorityOre(block, selected)

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(selected, info.Id) then
        return false
    end

    return not StoneOres[info.Id]
end

--------------------------------------------------
-- MINE ONE BLOCK
--------------------------------------------------

local function mineBlock(block, selected)

    if not block then
        return false
    end

    if not block.Parent then
        return false
    end

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(selected, info.Id) then
        return false
    end

    --------------------------------------------------
    -- KEEP HITTING UNTIL DESTROYED
    --------------------------------------------------

    while block.Parent
        and G.Settings["Auto Mine"] do

        damageSpecificBlock(block.Name)

        task.wait()
    end

    return true
end

--------------------------------------------------
-- FIND RANDOM BLOCK AT MAX DEPTH
--
-- PRIORITY ORES FIRST
-- STONE ONLY IF NO PRIORITY ORE EXISTS
--------------------------------------------------

local function getRandomBlockAtDepth(
    depth,
    selected,
    lastX,
    lastZ
)

    local folder = workspace.Maps.Mining.Blocks

    if not folder then
        return nil
    end

    local nearbyPriority = {}
    local allPriority = {}

    local nearbyStone = {}
    local allStone = {}

    --------------------------------------------------
    -- SCAN CURRENT DEPTH
    --------------------------------------------------

    for _, block in ipairs(folder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z =
                getBlockCoordinates(block)

            if x and y and z and y == depth then

                local info = getBlockInfo(block)

                if info
                    and table.find(selected, info.Id) then

                    --------------------------------------------------
                    -- PRIORITY ORE
                    --------------------------------------------------

                    if not StoneOres[info.Id] then

                        table.insert(
                            allPriority,
                            block
                        )

                        if math.abs(x - lastX) <= 5
                            and math.abs(z - lastZ) <= 5 then

                            table.insert(
                                nearbyPriority,
                                block
                            )
                        end

                    --------------------------------------------------
                    -- STONE
                    --------------------------------------------------

                    else

                        table.insert(
                            allStone,
                            block
                        )

                        if math.abs(x - lastX) <= 5
                            and math.abs(z - lastZ) <= 5 then

                            table.insert(
                                nearbyStone,
                                block
                            )
                        end

                    end
                end
            end
        end
    end

    --------------------------------------------------
    -- PRIORITY FIRST
    --------------------------------------------------

    if #nearbyPriority > 0 then

        return nearbyPriority[
            math.random(1, #nearbyPriority)
        ]
    end

    if #allPriority > 0 then

        return allPriority[
            math.random(1, #allPriority)
        ]
    end

    --------------------------------------------------
    -- NO PRIORITY ORE
    -- NOW USE STONE
    --------------------------------------------------

    if #nearbyStone > 0 then

        return nearbyStone[
            math.random(1, #nearbyStone)
        ]
    end

    if #allStone > 0 then

        return allStone[
            math.random(1, #allStone)
        ]
    end

    return nil
end

--------------------------------------------------
-- AUTO MINE
--------------------------------------------------

tabMain:addToggleMultiCombo(
    "Auto Mine",
    "...",
    Blocks,
    "All",

    function(value, selected)

        G.Settings["Auto Mine"] = value

        if not value then
            return
        end

        task.spawn(function()

            --------------------------------------------------
            -- STARTING VALUES
            --------------------------------------------------

            local currentDepth = 0
            local currentRank = nil

            --------------------------------------------------
            -- RANDOM MINING
            --------------------------------------------------

            local randomMining = false

            local randomX = 9
            local randomZ = 9

            local randomDepth = nil

            --------------------------------------------------
            -- MAIN LOOP
            --------------------------------------------------

            while G.Settings["Auto Mine"] do

                --------------------------------------------------
                -- GET CURRENT RANK
                --------------------------------------------------

                local rank, maxDepth = getRankDepth()

                if rank and maxDepth then

                    --------------------------------------------------
                    -- RANK CHANGED
                    --------------------------------------------------

                    if rank ~= currentRank then

                        currentRank = rank

                        currentDepth = 0

                        randomMining = false

                        randomDepth = nil

                        randomX = 9
                        randomZ = 9

                    end

                    --------------------------------------------------
                    -- DOWNWARD MINING
                    --
                    -- 9_0_9
                    -- 9_-1_9
                    -- 9_-2_9
                    -- ...
                    -- 9_-MAX_9
                    --------------------------------------------------

                    if not randomMining then

                        if math.abs(currentDepth) <= maxDepth then

                            local block =
                                getBlockAtDepth(
                                    9,
                                    currentDepth,
                                    9
                                )

                            if block then

                                local info =
                                    getBlockInfo(block)

                                if info
                                    and table.find(
                                        selected,
                                        info.Id
                                    ) then

                                    --------------------------------------------------
                                    -- IF PRIORITY ORE:
                                    -- MINE IT
                                    --------------------------------------------------

                                    if not StoneOres[info.Id] then

                                        mineBlock(
                                            block,
                                            selected
                                        )

                                    --------------------------------------------------
                                    -- IF STONE:
                                    -- MINE IT TOO
                                    --
                                    -- This prevents getting stuck.
                                    --------------------------------------------------

                                    else

                                        mineBlock(
                                            block,
                                            selected
                                        )

                                    end

                                end
                            end

                            --------------------------------------------------
                            -- ALWAYS CONTINUE DOWN
                            --------------------------------------------------

                            currentDepth -= 1

                        else

                            --------------------------------------------------
                            -- MAX DEPTH REACHED
                            --
                            -- SWITCH TO RANDOM
                            --------------------------------------------------

                            randomMining = true

                            randomDepth = -maxDepth

                            randomX = 9
                            randomZ = 9

                        end

                    else

                        --------------------------------------------------
                        -- RANDOM MINING AT MAX DEPTH
                        --------------------------------------------------

                        local randomBlock =
                            getRandomBlockAtDepth(
                                randomDepth,
                                selected,
                                randomX,
                                randomZ
                            )

                        if randomBlock then

                            local x, y, z =
                                getBlockCoordinates(
                                    randomBlock
                                )

                            if x and y and z then

                                --------------------------------------------------
                                -- SAVE LAST POSITION
                                --------------------------------------------------

                                randomX = x
                                randomZ = z

                                --------------------------------------------------
                                -- MINE IT
                                --------------------------------------------------

                                mineBlock(
                                    randomBlock,
                                    selected
                                )

                            end

                        else

                            --------------------------------------------------
                            -- NO BLOCK RIGHT NOW
                            -- KEEP SEARCHING
                            --------------------------------------------------

                            task.wait()
                        end
                    end

                else

                    task.wait()
                end

                task.wait()
            end

        end)
    end
)
