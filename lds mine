repeat task.wait() until game:IsLoaded()

local G = getgenv()

G.Settings = G.Settings or {}
G.Settings["Auto Mine"] = false

local lib = loadstring(game:HttpGet("https://projectlds.online/loader/Library"))()

local window = lib:start("Button Eternal 2", "1.0", true)

local tabMain = window:addTab("Main")

local Rs = cloneref(game:GetService("ReplicatedStorage"))
local Players = cloneref(game:GetService("Players"))

local BlocksFolder = workspace.Maps.Mining.Blocks

local BlocksData = require(Rs.Shared.Info.MiningInfo.Blocks)
local MiningServiceClient = require(Rs.Shared.Services.MiningService.MiningServiceClient)
local MiningInfo = require(Rs.Packages.Info).MiningInfo

local Blocks = {}

for i, g in pairs(BlocksData) do
    table.insert(Blocks, i)
end

----------------------------------------------------------------
-- RANK HOLDER
----------------------------------------------------------------

local holder =
    Players.LocalPlayer.PlayerGui.Main.Frames.Ranks_Mining.Holder.CurrentRank.Holder

----------------------------------------------------------------
-- RANK DEPTH
----------------------------------------------------------------

local RankDepths = {
    Starter = 9,
    Advanced = 9,

    Expert = 29,
    Master = 29,

    Elite = 69,
    Champion = 69,
    Legend = 69,

    Mythic = 149,
    Titan = 149,

    Immortal = 299,
    Celestial = 299,

    Cosmic = 799,
    Galactic = 799,
    Eternal = 799,
    Omniversal = 799
}

local CurrentRank = nil
local CurrentDepth = nil
local PathID = 0

----------------------------------------------------------------
-- GET RANK
----------------------------------------------------------------

local function getRank()

    local nameObject = holder:FindFirstChild("Name")

    if not nameObject then
        return nil
    end

    return nameObject.Text

end

----------------------------------------------------------------
-- UPDATE RANK
----------------------------------------------------------------

local function updateRank()

    local rank = getRank()

    if not rank then
        return false
    end

    local depth = RankDepths[rank]

    if not depth then
        warn("Unknown rank:", rank)
        return false
    end

    if rank ~= CurrentRank then

        CurrentRank = rank
        CurrentDepth = depth

        PathID += 1

        print("Rank:", rank)
        print("Max depth:", -depth)

        return true

    end

    return false

end

----------------------------------------------------------------
-- RANK CHECK
----------------------------------------------------------------

task.spawn(function()

    while true do

        if G.Settings["Auto Mine"] then
            updateRank()
        end

        task.wait()

    end

end)

----------------------------------------------------------------
-- DAMAGE BLOCK
----------------------------------------------------------------

local function damageSpecificBlock(blockName)

    if not MiningServiceClient.mineFolder then
        return false
    end

    local block =
        MiningServiceClient.mineFolder:FindFirstChild(blockName)

    if not block then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end

----------------------------------------------------------------
-- BLOCK INFO
----------------------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if blockId == "None" then
        return {
            Id = "None",
            Name = "Destroyed"
        }
    end

    local info = MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end

----------------------------------------------------------------
-- PARSE COORDINATES
--
-- Expected:
-- X_Y_Z
----------------------------------------------------------------

local function getCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x then
        return nil
    end

    return
        tonumber(x),
        tonumber(y),
        tonumber(z)

end

----------------------------------------------------------------
-- FIND ACTUAL BLOCK AT COORDINATES
----------------------------------------------------------------

local function getBlockAt(x, y, z)

    local name =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    return BlocksFolder:FindFirstChild(name)

end

----------------------------------------------------------------
-- FIND ALL ACTUAL BLOCKS AT X/Z
--
-- DOES NOT GUESS Y.
--
-- It reads the blocks that actually exist.
----------------------------------------------------------------

local function getColumnBlocks(x, z, maxDepth)

    local result = {}

    for _, block in ipairs(BlocksFolder:GetChildren()) do

        local bx, by, bz =
            getCoordinates(block)

        if bx
            and by
            and bz
            and bx == x
            and bz == z
            and by <= 0
            and by >= -maxDepth then

            table.insert(result, {
                block = block,
                y = by
            })

        end

    end

    table.sort(
        result,
        function(a, b)
            return a.y > b.y
        end
    )

    return result

end

----------------------------------------------------------------
-- MINE ONE BLOCK
----------------------------------------------------------------

local function mineBlock(
    block,
    selected,
    pathID
)

    if not block then
        return false
    end

    if not G.Settings["Auto Mine"] then
        return false
    end

    if pathID ~= PathID then
        return false
    end

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(
        selected,
        info.Id
    ) then
        return false
    end

    while block.Parent
        and G.Settings["Auto Mine"] do

        if pathID ~= PathID then
            return false
        end

        local currentInfo =
            getBlockInfo(block)

        if not currentInfo then
            break
        end

        if not table.find(
            selected,
            currentInfo.Id
        ) then
            break
        end

        damageSpecificBlock(
            block.Name
        )

        task.wait()

    end

    return true

end

----------------------------------------------------------------
-- GO DOWN USING REAL BLOCKS
----------------------------------------------------------------

local function goDown(
    selected,
    pathID
)

    local depth = CurrentDepth

    if not depth then
        return false
    end

    print(
        "Finding real blocks from 9,0,9 to",
        -depth
    )

    ------------------------------------------------------------
    -- READ ACTUAL BLOCKS FROM THE GAME
    ------------------------------------------------------------

    local column =
        getColumnBlocks(
            9,
            9,
            depth
        )

    if #column == 0 then

        warn(
            "No blocks found at X=9 Z=9"
        )

        return false

    end

    print(
        "Found",
        #column,
        "real blocks in starting column"
    )

    ------------------------------------------------------------
    -- MINE DOWN THROUGH ACTUAL BLOCKS
    ------------------------------------------------------------

    for _, entry in ipairs(column) do

        if not G.Settings["Auto Mine"] then
            return false
        end

        if pathID ~= PathID then
            return false
        end

        local block = entry.block
        local y = entry.y

        print(
            "Mining down:",
            block.Name
        )

        mineBlock(
            block,
            selected,
            pathID
        )

    end

    return true

end

----------------------------------------------------------------
-- FIND REAL BLOCKS AT MAX DEPTH
----------------------------------------------------------------

local function getDepthBlocks(depth)

    local result = {}

    for _, block in ipairs(
        BlocksFolder:GetChildren()
    ) do

        local x, y, z =
            getCoordinates(block)

        if x
            and y
            and z
            and y == -depth then

            table.insert(
                result,
                block
            )

        end

    end

    return result

end

----------------------------------------------------------------
-- MINE MAX DEPTH
--
-- Uses ACTUAL blocks in BlocksFolder.
----------------------------------------------------------------

local function mineDepthLayer(
    selected,
    pathID
)

    local depth = CurrentDepth

    if not depth then
        return
    end

    local y = -depth

    print(
        "Looking for actual blocks at Y:",
        y
    )

    local layerBlocks =
        getDepthBlocks(depth)

    if #layerBlocks == 0 then

        warn(
            "No blocks found at depth:",
            y
        )

        return

    end

    print(
        "Found",
        #layerBlocks,
        "blocks at depth",
        y
    )

    ------------------------------------------------------------
    -- SORT BY Z THEN X
    ------------------------------------------------------------

    table.sort(
        layerBlocks,
        function(a, b)

            local ax, ay, az =
                getCoordinates(a)

            local bx, by, bz =
                getCoordinates(b)

            if az == bz then
                return ax < bx
            end

            return az > bz

        end
    )

    ------------------------------------------------------------
    -- MINE ACTUAL BLOCKS
    ------------------------------------------------------------

    for _, block in ipairs(layerBlocks) do

        if not G.Settings["Auto Mine"] then
            return
        end

        if pathID ~= PathID then
            return
        end

        mineBlock(
            block,
            selected,
            pathID
        )

    end

end

----------------------------------------------------------------
-- COMPLETE MINING PATH
----------------------------------------------------------------

local function minePath(selected)

    updateRank()

    if not CurrentRank then
        return
    end

    local pathID = PathID

    print("================================")
    print("START")
    print("Rank:", CurrentRank)
    print("Depth:", -CurrentDepth)
    print("================================")

    ------------------------------------------------------------
    -- GO DOWN
    ------------------------------------------------------------

    local reached =
        goDown(
            selected,
            pathID
        )

    if not reached then
        return
    end

    ------------------------------------------------------------
    -- RANK CHANGED?
    ------------------------------------------------------------

    if pathID ~= PathID then
        return
    end

    ------------------------------------------------------------
    -- MINE ACTUAL MAX-DEPTH LAYER
    ------------------------------------------------------------

    mineDepthLayer(
        selected,
        pathID
    )

end

----------------------------------------------------------------
-- AUTO MINE
----------------------------------------------------------------

tabMain:addToggleMultiCombo(
    "Auto Mine",
    "...",
    Blocks,
    "All",

    function(value, selected)

        G.Settings["Auto Mine"] = value

        if not value then

            PathID += 1

            print("Auto Mine OFF")

            return

        end

        --------------------------------------------------------
        -- INITIAL RANK
        --------------------------------------------------------

        updateRank()

        if not CurrentDepth then
            warn("Could not determine rank depth")
            return
        end

        print(
            "Auto Mine ON"
        )

        print(
            "Rank:",
            CurrentRank
        )

        print(
            "Maximum depth:",
            -CurrentDepth
        )

        --------------------------------------------------------
        -- MAIN LOOP
        --------------------------------------------------------

        task.spawn(function()

            while G.Settings["Auto Mine"] do

                updateRank()

                minePath(selected)

                task.wait()

            end

        end)

    end
)
