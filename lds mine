repeat task.wait() until game:IsLoaded()

local G = getgenv()

G.Settings = G.Settings or {}
G.Settings["Auto Mine"] = false

local lib = loadstring(game:HttpGet("https://projectlds.online/loader/Library"))()

local window = lib:start("Button Eternal 2", "1.0", true)

local tabMain = window:addTab("Main")

local Rs = cloneref(game:GetService("ReplicatedStorage"))
local Players = cloneref(game:GetService("Players"))

local BlocksData = require(Rs.Shared.Info.MiningInfo.Blocks)
local MiningServiceClient = require(Rs.Shared.Services.MiningService.MiningServiceClient)
local MiningInfo = require(Rs.Packages.Info).MiningInfo

local Blocks = {}

for i, g in pairs(BlocksData) do
    table.insert(Blocks, i)
end

----------------------------------------------------------------
-- RANK HOLDER
----------------------------------------------------------------

local holder =
    game:GetService("Players").LocalPlayer
    .PlayerGui.Main.Frames.Ranks_Mining.Holder.CurrentRank.Holder

----------------------------------------------------------------
-- RANK -> MAX DEPTH
----------------------------------------------------------------

local RankDepths = {
    Starter = 9,
    Advanced = 9,

    Expert = 29,
    Master = 29,

    Elite = 69,
    Champion = 69,
    Legend = 69,

    Mythic = 149,
    Titan = 149,

    Immortal = 299,
    Celestial = 299,

    Cosmic = 799,
    Galactic = 799,
    Eternal = 799,
    Omniversal = 799
}

----------------------------------------------------------------
-- CURRENT RANK
----------------------------------------------------------------

local CurrentRank = nil
local CurrentDepth = nil

-- Changes whenever rank changes.
-- This makes the current path stop.
local PathID = 0

----------------------------------------------------------------
-- GET RANK
--
-- EXACTLY THE METHOD YOU PROVIDED
----------------------------------------------------------------

local function getRank()

    local nameObject = holder:FindFirstChild("Name")

    if not nameObject then
        return nil
    end

    return nameObject.Text

end

----------------------------------------------------------------
-- UPDATE RANK
----------------------------------------------------------------

local function updateRank()

    local rank = getRank()

    if not rank then
        return false
    end

    local depth = RankDepths[rank]

    if not depth then
        warn("Rank not found:", rank)
        return false
    end

    if rank ~= CurrentRank then

        CurrentRank = rank
        CurrentDepth = depth

        PathID += 1

        print("================================")
        print("RANK:", CurrentRank)
        print("MAX DEPTH:", -CurrentDepth)
        print("RESTARTING PATH")
        print("================================")

        return true
    end

    return false

end

----------------------------------------------------------------
-- RANK CHECK LOOP
----------------------------------------------------------------

task.spawn(function()

    while true do

        if G.Settings["Auto Mine"] then
            updateRank()
        end

        task.wait()

    end

end)

----------------------------------------------------------------
-- DAMAGE BLOCK
----------------------------------------------------------------

damageSpecificBlock = function(blockName)

    if not MiningServiceClient.mineFolder then
        warn("MiningServiceClient ainda não foi inicializado")
        return false
    end

    local block =
        MiningServiceClient.mineFolder:FindFirstChild(blockName)

    if not block then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    MiningServiceClient.currentBlock = block
    MiningServiceClient:damageBlock()

    return true

end

----------------------------------------------------------------
-- GET BLOCK INFO
----------------------------------------------------------------

getBlockInfo = function(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if blockId == "None" then
        return {
            Id = "None",
            Name = "Bloco destruído"
        }
    end

    local info = MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end

----------------------------------------------------------------
-- GET BLOCK AT COORDINATE
----------------------------------------------------------------

local function getBlock(x, y, z)

    local name =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    return workspace.Maps.Mining.Blocks:FindFirstChild(name)

end

----------------------------------------------------------------
-- MINE BLOCK AT COORDINATE
----------------------------------------------------------------

local function mineCoordinate(
    x,
    y,
    z,
    selected,
    pathID
)

    if not G.Settings["Auto Mine"] then
        return false
    end

    -- Rank changed.
    if pathID ~= PathID then
        return false
    end

    -- Don't go below current rank depth.
    if y < -CurrentDepth then
        return false
    end

    local block = getBlock(x, y, z)

    if not block then
        return false
    end

    local info = getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(selected, info.Id) then
        return false
    end

    ------------------------------------------------------------
    -- MINE UNTIL BLOCK IS GONE
    ------------------------------------------------------------

    while block.Parent
        and G.Settings["Auto Mine"] do

        if pathID ~= PathID then
            return false
        end

        if y < -CurrentDepth then
            return false
        end

        local currentInfo =
            getBlockInfo(block)

        if not currentInfo then
            break
        end

        if not table.find(
            selected,
            currentInfo.Id
        ) then
            break
        end

        damageSpecificBlock(block.Name)

        task.wait()

    end

    return true

end

----------------------------------------------------------------
-- GO DOWN
----------------------------------------------------------------

local function goDown(selected, pathID)

    local depth = CurrentDepth

    print(
        "Going down from 9_0_9 to:",
        "9_" .. tostring(-depth) .. "_9"
    )

    for y = 0, -depth, -1 do

        if not G.Settings["Auto Mine"] then
            return false
        end

        if pathID ~= PathID then
            return false
        end

        mineCoordinate(
            9,
            y,
            9,
            selected,
            pathID
        )

    end

    return true

end

----------------------------------------------------------------
-- MINE MAX DEPTH LAYER
----------------------------------------------------------------

local function mineLayer(selected, pathID)

    local y = -CurrentDepth

    print(
        "Mining layer:",
        y
    )

    local leftToRight = true

    ------------------------------------------------------------
    -- SAME ZIGZAG
    ------------------------------------------------------------

    for z = 50, -50, -2 do

        if not G.Settings["Auto Mine"] then
            return
        end

        if pathID ~= PathID then
            return
        end

        if leftToRight then

            ----------------------------------------------------
            -- LEFT -> RIGHT
            ----------------------------------------------------

            for x = -50, 50, 1 do

                if not G.Settings["Auto Mine"] then
                    return
                end

                if pathID ~= PathID then
                    return
                end

                mineCoordinate(
                    x,
                    y,
                    z,
                    selected,
                    pathID
                )

            end

        else

            ----------------------------------------------------
            -- RIGHT -> LEFT
            ----------------------------------------------------

            for x = 50, -50, -1 do

                if not G.Settings["Auto Mine"] then
                    return
                end

                if pathID ~= PathID then
                    return
                end

                mineCoordinate(
                    x,
                    y,
                    z,
                    selected,
                    pathID
                )

            end

        end

        leftToRight = not leftToRight

    end

end

----------------------------------------------------------------
-- COMPLETE PATH
----------------------------------------------------------------

local function startMiningPath(selected)

    ------------------------------------------------------------
    -- GET CURRENT RANK
    ------------------------------------------------------------

    updateRank()

    if not CurrentRank or not CurrentDepth then
        warn("Could not determine rank/depth")
        return
    end

    local pathID = PathID

    print("================================")
    print("STARTING MINING")
    print("Rank:", CurrentRank)
    print("Depth:", -CurrentDepth)
    print("================================")

    ------------------------------------------------------------
    -- GO DOWN
    ------------------------------------------------------------

    local reachedDepth =
        goDown(
            selected,
            pathID
        )

    if not reachedDepth then
        return
    end

    ------------------------------------------------------------
    -- MINE THE LAYER
    ------------------------------------------------------------

    if pathID ~= PathID then
        return
    end

    mineLayer(
        selected,
        pathID
    )

end

----------------------------------------------------------------
-- AUTO MINE
----------------------------------------------------------------

tabMain:addToggleMultiCombo(
    "Auto Mine",
    "...",
    Blocks,
    "All",

    function(value, selected)

        G.Settings["Auto Mine"] = value

        if not value then

            -- Stop current path.
            PathID += 1

            print("Auto Mine OFF")

            return
        end

        --------------------------------------------------------
        -- INITIAL RANK
        --------------------------------------------------------

        updateRank()

        print(
            "Auto Mine ON | Rank:",
            CurrentRank,
            "| Depth:",
            -CurrentDepth
        )

        --------------------------------------------------------
        -- MAIN MINING LOOP
        --------------------------------------------------------

        task.spawn(function()

            while G.Settings["Auto Mine"] do

                ------------------------------------------------
                -- CHECK RANK
                ------------------------------------------------

                updateRank()

                ------------------------------------------------
                -- START FROM 9_0_9
                -- AND GO TO CURRENT MAX DEPTH
                ------------------------------------------------

                startMiningPath(selected)

                ------------------------------------------------
                -- If rank changed during the path,
                -- PathID changed and this starts over.
                ------------------------------------------------

                task.wait()

            end

        end)

    end
)
