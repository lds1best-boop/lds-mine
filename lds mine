--------------------------------------------------
-- CURRENT RANK
--------------------------------------------------

local function getCurrentRank()

    local playerGui =
        LocalPlayer:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local main =
        playerGui:FindFirstChild("Main")

    if not main then
        return nil
    end

    local frames =
        main:FindFirstChild("Frames")

    if not frames then
        return nil
    end

    local ranksMining =
        frames:FindFirstChild("Ranks_Mining")

    if not ranksMining then
        return nil
    end

    local holder =
        ranksMining:FindFirstChild("Holder")

    if not holder then
        return nil
    end

    local currentRank =
        holder:FindFirstChild("CurrentRank")

    if not currentRank then
        return nil
    end

    local currentHolder =
        currentRank:FindFirstChild("Holder")

    if not currentHolder then
        return nil
    end

    local nameObject =
        currentHolder:FindFirstChild("Name")

    if not nameObject then
        return nil
    end

    if not nameObject:IsA("TextLabel")
        and not nameObject:IsA("TextButton")
        and not nameObject:IsA("TextBox") then

        return nil
    end

    return nameObject.Text
end

--------------------------------------------------
-- GET RANK DEPTH
--------------------------------------------------

local function getRankDepth()

    local rank = getCurrentRank()

    if not rank then
        return nil, nil
    end

    rank =
        rank:gsub("^%s+", "")
            :gsub("%s+$", "")

    return rank, RankDepths[rank]
end

--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[block.Name]

    if not blockData then
        return nil
    end

    local blockId = blockData[1]

    if blockId == "None" then
        return nil
    end

    local info =
        MiningInfo:getBlock(blockId)

    if not info then
        return nil
    end

    return {
        Id = blockId,

        Name = info.name,

        HP = info.hp,

        Value = info.value,

        Model = info.model,

        Rarity =
            info.rarity
            or info.Rarity
            or info.rarityName
    }
end

--------------------------------------------------
-- RARITY PRIORITY
--------------------------------------------------

local RarityPriority = {

    Common = 1,
    Uncommon = 2,
    Rare = 3,
    Epic = 4,
    Legendary = 5,
    Mythic = 6,
    Divine = 7,
    Celestial = 8,
    Cosmic = 9,
    Secret = 10
}

local function getRarityPriority(info)

    if not info then
        return 0
    end

    local rarity = info.Rarity

    if type(rarity) == "number" then
        return rarity
    end

    if type(rarity) == "string" then
        return RarityPriority[rarity] or 0
    end

    return 0
end

--------------------------------------------------
-- COORDINATES
--------------------------------------------------

local function getBlockCoordinates(block)

    if not block then
        return nil
    end

    local x, y, z =
        block.Name:match(
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    if not x then
        return nil
    end

    return
        tonumber(x),
        tonumber(y),
        tonumber(z)
end

--------------------------------------------------
-- GET BLOCK AT DEPTH
--------------------------------------------------

local function getBlockAtDepth(x, y, z)

    local maps =
        workspace:FindFirstChild("Maps")

    if not maps then
        return nil
    end

    local mining =
        maps:FindFirstChild("Mining")

    if not mining then
        return nil
    end

    local folder =
        mining:FindFirstChild("Blocks")

    if not folder then
        return nil
    end

    local blockName =
        tostring(x) .. "_" ..
        tostring(y) .. "_" ..
        tostring(z)

    return folder:FindFirstChild(blockName)
end

--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageSpecificBlock(blockName)

    if not MiningServiceClient.mineFolder then
        return false
    end

    local block =
        MiningServiceClient.mineFolder
        :FindFirstChild(blockName)

    if not block then
        return false
    end

    if not block:GetAttribute("isBlock") then
        return false
    end

    MiningServiceClient.currentBlock = block

    MiningServiceClient:damageBlock()

    return true
end

--------------------------------------------------
-- MINE BLOCK
--------------------------------------------------

local function mineBlock(
    block,
    selected,
    resetToken
)

    if not block then
        return false
    end

    local info =
        getBlockInfo(block)

    if not info then
        return false
    end

    if not table.find(selected, info.Id) then
        return false
    end

    while
        block.Parent
        and G.Settings["Auto Mine"]
        and resetToken == G.MiningResetToken
    do

        damageSpecificBlock(block.Name)

        task.wait()
    end

    return true
end

--------------------------------------------------
-- FIND BEST BLOCK ON LAYER
--------------------------------------------------

local function getBestBlockAtDepth(
    depth,
    selected,
    lastX,
    lastZ
)

    local maps =
        workspace:FindFirstChild("Maps")

    if not maps then
        return nil
    end

    local mining =
        maps:FindFirstChild("Mining")

    if not mining then
        return nil
    end

    local folder =
        mining:FindFirstChild("Blocks")

    if not folder then
        return nil
    end

    local priorityBlocks = {}

    local stoneBlocks = {}

    for _, block in ipairs(folder:GetChildren()) do

        if block:GetAttribute("isBlock") then

            local x, y, z =
                getBlockCoordinates(block)

            if
                x
                and y
                and z
                and y == depth
            then

                local info =
                    getBlockInfo(block)

                if info
                    and table.find(
                        selected,
                        info.Id
                    )
                then

                    local distance =
                        math.abs(x - lastX)
                        +
                        math.abs(z - lastZ)

                    --------------------------------------------------
                    -- STONE
                    --------------------------------------------------

                    if StoneOres[info.Id] then

                        table.insert(
                            stoneBlocks,
                            {
                                Block = block,
                                Distance = distance
                            }
                        )

                    --------------------------------------------------
                    -- ORE
                    --------------------------------------------------

                    else

                        table.insert(
                            priorityBlocks,
                            {
                                Block = block,

                                Rarity =
                                    getRarityPriority(info),

                                Distance = distance
                            }
                        )
                    end
                end
            end
        end
    end

    --------------------------------------------------
    -- SORT ORES
    --------------------------------------------------

    table.sort(
        priorityBlocks,
        function(a, b)

            if a.Rarity ~= b.Rarity then
                return a.Rarity > b.Rarity
            end

            return a.Distance < b.Distance
        end
    )

    --------------------------------------------------
    -- ORE FIRST
    --------------------------------------------------

    if #priorityBlocks > 0 then
        return priorityBlocks[1].Block
    end

    --------------------------------------------------
    -- STONE ONLY IF NO ORE
    --------------------------------------------------

    if #stoneBlocks > 0 then

        table.sort(
            stoneBlocks,
            function(a, b)
                return a.Distance < b.Distance
            end
        )

        return stoneBlocks[1].Block
    end

    return nil
end

