--------------------------------------------------
-- DROPDOWN CHANGED
--------------------------------------------------

BlockDropdown:OnChanged(function(value)

    rebuildSelectedBlocks(value)

    --------------------------------------------------
    -- REMOVE BEDROCK
    --------------------------------------------------

    local cleanSelection = {}

    for _, blockId in ipairs(SelectedBlocks) do

        if string.lower(
            tostring(blockId)
        ) ~= "bedrock" then

            table.insert(
                cleanSelection,
                blockId
            )
        end
    end

    SelectedBlocks =
        cleanSelection

    --------------------------------------------------
    -- IF AUTO MINE IS ON,
    -- RESTART FROM 0
    --------------------------------------------------

    if AutoMineEnabled then

        resetMiningCycle()

        task.wait(0.1)

        if AutoMineEnabled then
            startMining()
        end
    end
end)

