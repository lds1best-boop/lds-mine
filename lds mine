--------------------------------------------------
-- CONVERT FLUENT SELECTION
--
-- Fluent gives:
--
-- {
--     StoneOre = true,
--     Diamond = true
-- }
--
-- Mining system uses:
--
-- {
--     "StoneOre",
--     "Diamond"
-- }
--------------------------------------------------

local function updateSelectedBlocks(value)

    SelectedBlocks = {}

    if type(value) ~= "table" then
        return
    end

    for blockId, enabled in pairs(value) do

        if enabled then
            table.insert(
                SelectedBlocks,
                blockId
            )
        end
    end
end

--------------------------------------------------
-- BLOCK SELECTION CHANGE
--
-- WAIT 20 SECONDS
-- THEN OFF
-- WAIT 0.8
-- THEN ON
--------------------------------------------------

local SelectionChangeId = 0

BlockDropdown:OnChanged(
    function(value)

        updateSelectedBlocks(value)

        SelectionChangeId += 1

        local thisChange =
            SelectionChangeId

        --------------------------------------------------
        -- ONLY DO THIS IF AUTO MINE IS ON
        --------------------------------------------------

        if not G.Settings["Auto Mine"] then
            return
        end

        task.spawn(function()

            --------------------------------------------------
            -- WAIT 20 SECONDS
            --------------------------------------------------

            task.wait(20)

            --------------------------------------------------
            -- ANOTHER SELECTION CHANGE HAPPENED
            --------------------------------------------------

            if thisChange ~= SelectionChangeId then
                return
            end

            if not G.Settings["Auto Mine"] then
                return
            end

            --------------------------------------------------
            -- TURN OFF
            --------------------------------------------------

            AutoMineToggle:SetValue(false)

            --------------------------------------------------
            -- WAIT 0.8 SECONDS
            --------------------------------------------------

            task.wait(0.8)

            if thisChange ~= SelectionChangeId then
                return
            end

            --------------------------------------------------
            -- TURN ON
            --------------------------------------------------

            AutoMineToggle:SetValue(true)

        end)

    end
)

--------------------------------------------------
-- AUTO MINE CHANGED
--------------------------------------------------

AutoMineToggle:OnChanged(
    function()

        local value =
            AutoMineToggle.Value

        G.Settings["Auto Mine"] =
            value

        --------------------------------------------------
        -- OFF
        --------------------------------------------------

        if not value then

            resetMiningCycle()

            return
        end

        --------------------------------------------------
        -- NO BLOCKS
        --------------------------------------------------

        if #SelectedBlocks == 0 then

            AutoMineToggle:SetValue(false)

            Fluent:Notify({
                Title = "Auto Mine",
                Content = "Select at least one block first.",
                Duration = 3
            })

            return
        end

        --------------------------------------------------
        -- NEW MINING SESSION
        --------------------------------------------------

        local resetToken =
            resetMiningCycle()

        task.spawn(function()

            --------------------------------------------------
            -- ALWAYS START AT 0
            --------------------------------------------------

            local currentDepth = 0

            --------------------------------------------------
            -- CURRENT RANK
            --------------------------------------------------

            local currentRank = nil

            --------------------------------------------------
            -- CURRENT MAX DEPTH
            --------------------------------------------------

            local currentMaxDepth = nil

            --------------------------------------------------
            -- RANDOM MODE
            --------------------------------------------------

            local randomMining = false

            local randomX = 9
            local randomZ = 9

            --------------------------------------------------
            -- FINAL 3 LAYERS
            --------------------------------------------------

            local randomLayers = {}

            local randomLayerIndex = 1

            --------------------------------------------------
            -- MAIN LOOP
            --------------------------------------------------

            while
                G.Settings["Auto Mine"]
                and resetToken == G.MiningResetToken
            do

                --------------------------------------------------
                -- UPDATE SELECTED BLOCKS
                --------------------------------------------------

                local selected =
                    SelectedBlocks

                if #selected == 0 then

                    task.wait(0.5)

                    continue
                end

                --------------------------------------------------
                -- GET RANK
                --------------------------------------------------

                local rank, maxDepth =
                    getRankDepth()

                if rank and maxDepth then

                    --------------------------------------------------
                    -- FIRST INITIALIZATION
                    --------------------------------------------------

                    if currentMaxDepth == nil then

                        currentRank = rank

                        currentMaxDepth =
                            maxDepth

                        --------------------------------------------------
                        -- START AT 0
                        --------------------------------------------------

                        currentDepth = 0

                        randomMining = false

                        randomX = 9
                        randomZ = 9

                        randomLayers = {}

                        randomLayerIndex = 1
                    end

                    --------------------------------------------------
                    -- NEW DEEPER LAYER UNLOCKED
                    --
                    -- 9 -> 29
                    -- 29 -> 69
                    -- 69 -> 149
                    -- 149 -> 299
                    -- 299 -> 799
                    --
                    -- RESET TO 0
                    --------------------------------------------------

                    if maxDepth > currentMaxDepth then

                        currentRank = rank

                        currentMaxDepth =
                            maxDepth

                        currentDepth = 0

                        randomMining = false

                        randomX = 9
                        randomZ = 9

                        randomLayers = {}

                        randomLayerIndex = 1

                        resetToken =
                            resetMiningCycle()

                        resetToken =
                            G.MiningResetToken

                        task.wait(0.5)

                        continue
                    end

                    --------------------------------------------------
                    -- RANK CHANGED
                    --
                    -- EVEN IF DEPTH IS SAME,
                    -- START AGAIN FROM 0.
                    --------------------------------------------------

                    if rank ~= currentRank then

                        currentRank = rank

                        currentDepth = 0

                        randomMining = false

                        randomX = 9
                        randomZ = 9

                        randomLayers = {}

                        randomLayerIndex = 1

                        resetToken =
                            resetMiningCycle()

                        resetToken =
                            G.MiningResetToken

                        task.wait(0.5)

                        continue
                    end

                    --------------------------------------------------
                    -- NORMAL DOWNWARD MINING
                    --------------------------------------------------

                    if not randomMining then

                        --------------------------------------------------
                        -- 0 -> -MAX
                        --------------------------------------------------

                        if
                            math.abs(currentDepth)
                            <= maxDepth
                        then

                            local block =
                                getBlockAtDepth(
                                    9,
                                    currentDepth,
                                    9
                                )

                            if block then

                                local info =
                                    getBlockInfo(block)

                                if
                                    info
                                    and table.find(
                                        selected,
                                        info.Id
                                    )
                                then

                                    mineBlock(
                                        block,
                                        selected,
                                        resetToken
                                    )
                                end
                            end

                            --------------------------------------------------
                            -- NEXT LAYER
                            --------------------------------------------------

                            currentDepth -= 1

                        else

                            --------------------------------------------------
                            -- MAX DEPTH REACHED
                            --------------------------------------------------

                            randomMining = true

                            randomLayers = {

                                -maxDepth,

                                -maxDepth + 1,

                                -maxDepth + 2
                            }

                            randomLayerIndex = 1

                            randomX = 9
                            randomZ = 9
                        end

                    else

                        --------------------------------------------------
                        -- RANDOM FINAL 3 LAYERS
                        --------------------------------------------------

                        local randomDepth =
                            randomLayers[
                                randomLayerIndex
                            ]

                        local randomBlock =
                            getBestBlockAtDepth(
                                randomDepth,
                                selected,
                                randomX,
                                randomZ
                            )

                        if randomBlock then

                            local x, y, z =
                                getBlockCoordinates(
                                    randomBlock
                                )

                            if x and y and z then

                                randomX = x
                                randomZ = z

                                mineBlock(
                                    randomBlock,
                                    selected,
                                    resetToken
                                )
                            end

                        else

                            --------------------------------------------------
                            -- NEXT RANDOM LAYER
                            --------------------------------------------------

                            randomLayerIndex += 1

                            if randomLayerIndex > 3 then

                                randomLayerIndex = 1

                            end

                            task.wait()
                        end
                    end

                else

                    task.wait(0.25)
                end

                task.wait()
            end
        end)
    end
)

